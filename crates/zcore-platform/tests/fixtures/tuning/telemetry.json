{
  "schema": "zairenkai.tuning",
  "schema_version": 1,
  "kind": "telemetry",
  "component": {
    "name": "zairenkai-tuning",
    "version": "0.1.0"
  },
  "interval_ms": 200,
  "platform": {
    "vendor": "qualcomm",
    "qualcomm_score": 8,
    "mediatek_score": 0,
    "signals": [
      "devicetree compatible: qcom (+3)",
      "/dev/kgsl-3d0 exists (+3)",
      "/sys/class/kgsl exists (+2)"
    ]
  },
  "cpu": {
    "present": {
      "status": "ok",
      "value": [
        0,
        1
      ],
      "unit": "count",
      "source": "/sys/devices/system/cpu/present"
    },
    "load": {
      "status": "unavailable",
      "value": null,
      "unit": "percent",
      "detail": "no jiffies elapsed or core absent from /proc/stat"
    },
    "cores": [
      {
        "id": 0,
        "cur_freq": {
          "status": "ok",
          "value": 1804800,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq"
        },
        "min_freq": {
          "status": "ok",
          "value": 300000,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq"
        },
        "max_freq": {
          "status": "ok",
          "value": 1804800,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"
        },
        "governor": {
          "status": "ok",
          "value": "schedutil",
          "unit": "text",
          "source": "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
        },
        "load": {
          "status": "unavailable",
          "value": null,
          "unit": "percent",
          "detail": "no jiffies elapsed or core absent from /proc/stat"
        }
      },
      {
        "id": 1,
        "cur_freq": {
          "status": "ok",
          "value": 300000,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu1/cpufreq/scaling_cur_freq"
        },
        "min_freq": {
          "status": "ok",
          "value": 300000,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu1/cpufreq/cpuinfo_min_freq"
        },
        "max_freq": {
          "status": "ok",
          "value": 1804800,
          "unit": "kHz",
          "source": "/sys/devices/system/cpu/cpu1/cpufreq/cpuinfo_max_freq"
        },
        "governor": {
          "status": "ok",
          "value": "schedutil",
          "unit": "text",
          "source": "/sys/devices/system/cpu/cpu1/cpufreq/scaling_governor"
        },
        "load": {
          "status": "unavailable",
          "value": null,
          "unit": "percent",
          "detail": "no jiffies elapsed or core absent from /proc/stat"
        }
      }
    ]
  },
  "thermal": {
    "cpu": {
      "status": "ok",
      "value": 45.1,
      "unit": "celsius",
      "source": "/sys/class/thermal/thermal_zone0/temp (cpu-0-0-usr)",
      "detail": "raw value divided by 1000"
    },
    "gpu": {
      "status": "ok",
      "value": 51.3,
      "unit": "celsius",
      "source": "/sys/class/thermal/thermal_zone1/temp (gpuss-0-usr)",
      "detail": "raw value divided by 1000"
    }
  },
  "memory": {
    "total": {
      "status": "ok",
      "value": 8192000000,
      "unit": "bytes",
      "source": "/proc/meminfo MemTotal"
    },
    "available": {
      "status": "ok",
      "value": 3072000000,
      "unit": "bytes",
      "source": "/proc/meminfo MemAvailable"
    },
    "used": {
      "status": "ok",
      "value": 5120000000,
      "unit": "bytes",
      "source": "/proc/meminfo MemTotal - MemAvailable"
    },
    "swap_total": {
      "status": "ok",
      "value": 4096000000,
      "unit": "bytes",
      "source": "/proc/meminfo SwapTotal"
    },
    "swap_used": {
      "status": "ok",
      "value": 1024000000,
      "unit": "bytes",
      "source": "/proc/meminfo SwapTotal - SwapFree"
    }
  },
  "gpu": {
    "devfreq": "/sys/class/kgsl/kgsl-3d0/devfreq",
    "cur_freq": {
      "status": "ok",
      "value": 257000000,
      "unit": "Hz",
      "source": "/sys/class/kgsl/kgsl-3d0/devfreq/cur_freq"
    },
    "governor": {
      "status": "ok",
      "value": "msm-adreno-tz",
      "unit": "text",
      "source": "/sys/class/kgsl/kgsl-3d0/devfreq/governor"
    }
  },
  "storage": [
    {
      "device": "sda",
      "scheduler": {
        "status": "ok",
        "value": "mq-deadline",
        "unit": "text",
        "source": "/sys/block/sda/queue/scheduler"
      }
    },
    {
      "device": "sdb",
      "scheduler": {
        "status": "ok",
        "value": "mq-deadline",
        "unit": "text",
        "source": "/sys/block/sdb/queue/scheduler"
      }
    }
  ]
}
