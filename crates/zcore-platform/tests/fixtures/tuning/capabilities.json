{
  "schema": "zairenkai.tuning",
  "schema_version": 1,
  "kind": "capabilities",
  "component": {
    "name": "zairenkai-tuning",
    "version": "0.1.0"
  },
  "capabilities": [
    {
      "id": "telemetry.cpu",
      "state": "available",
      "evidence": [
        "/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq"
      ]
    },
    {
      "id": "telemetry.thermal.cpu",
      "state": "available",
      "evidence": [
        "/sys/class/thermal/thermal_zone0/temp (cpu-0-0-usr)"
      ]
    },
    {
      "id": "telemetry.thermal.gpu",
      "state": "available",
      "evidence": [
        "/sys/class/thermal/thermal_zone1/temp (gpuss-0-usr)"
      ]
    },
    {
      "id": "telemetry.memory",
      "state": "available",
      "evidence": [
        "/proc/meminfo"
      ]
    },
    {
      "id": "telemetry.gpu",
      "state": "available",
      "evidence": [
        "/sys/class/kgsl/kgsl-3d0/devfreq"
      ]
    },
    {
      "id": "io.scheduler",
      "state": "not_verified",
      "operation": "io.scheduler",
      "allowed_values": [
        "mq-deadline",
        "kyber",
        "none"
      ],
      "current": "mq-deadline",
      "evidence": [
        "/sys/block/sda/queue/scheduler",
        "/sys/block/sdb/queue/scheduler"
      ]
    },
    {
      "id": "gpu.governor",
      "state": "not_verified",
      "operation": "gpu.governor",
      "allowed_values": [
        "msm-adreno-tz",
        "performance",
        "powersave"
      ],
      "current": "msm-adreno-tz",
      "evidence": [
        "/sys/class/kgsl/kgsl-3d0/devfreq/governor"
      ]
    }
  ]
}
